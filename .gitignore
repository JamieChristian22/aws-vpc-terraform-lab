
# Terraform local working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan
*.tfplan.*
tfplan
tfplan.*

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Local environment files
.env
.env.*
!.env.example

# Operating system and editor files
.DS_Store
.vscode/
.idea/

# Local cloud credentials and sensitive infrastructure artifacts
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*.kubeconfig

# Local credentials and infrastructure artifacts (prevent accidental new tracking)
!*.tfvars.example
.terraform/
id_rsa
id_ed25519
.aws/credentials
.kube/config
